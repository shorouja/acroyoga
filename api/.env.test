# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Local dev/test runs on SQLite (no Docker/pdo_pgsql locally); prod is PostgreSQL 17.
# The test schema is built from entity metadata via `doctrine:schema:create --env=test`,
# so the dialect is irrelevant to these functional tests.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
