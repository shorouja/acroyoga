danielschwabe.com, www.danielschwabe.com {
    handle /bundles/* {
        root * /var/www/acroyoga/api/public
        file_server
    }
    handle /api* {
        root * /var/www/acroyoga/api/public
        php_fastcgi unix//run/php/php8.4-fpm.sock
        file_server
    }
    handle {
        root * /var/www/acroyoga/frontend/dist
        # SPA deep links (e.g. /exercises/5) must fall back to index.html
        # so the client-side router can handle them instead of 404ing.
        try_files {path} /index.html
        file_server
    }
}
